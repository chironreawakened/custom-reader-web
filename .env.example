# Copy to the secrets location (e.g. /home/ubuntu/reader/.env) and fill in.
# NEVER commit real values.

# 32 random bytes, base64. Losing this = losing all content. Back it up.
APP_MASTER_KEY=REPLACE_ME_BASE64_32_BYTES

# Hippius (S3-compatible)
HIPPUS_ENDPOINT=https://eu-central-1.hippius.com
HIPPUS_REGION=decentralized
HIPPUS_BUCKET=REPLACE_WITH_BUCKET
HIPPUS_ACCESS_KEY=hip_REPLACE_ME
HIPPUS_SECRET_KEY=REPLACE_ME

# Mailer (Gmail SMTP)
MAILER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD

# Auth
ALLOWED_EMAIL=you@gmail.com

# DuckDNS hostname (Caddy + Let's Encrypt)
RDR_HOSTNAME=name.duckdns.org

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=reader
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=reader
