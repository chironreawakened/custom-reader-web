# Personal Reader site. Hostname: peisetti.duckdns.org (owner-chosen 2026-10-29).
# This block is appended to the Mattermost Caddy config (one reverse proxy
# for both, auto Let's Encrypt via HTTP-01).
peisetti.duckdns.org {
    encode gzip

    # API
    handle /v1/* {
        reverse_proxy 127.0.0.1:3100
    }

    # static web build (baked into the caddy image in CI, or served from host path)
    handle {
        root * /srv/reader/web-dist
        try_files {path} /index.html
        file_server
    }
}
